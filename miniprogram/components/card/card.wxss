/* 扑克牌卡面:纯 CSS,无图片;PokerNow 风格 — 米白面 + 扁平牌背 */
.card {
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #f7f3e8;
  border: 2rpx solid #d8d2c0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
}

/* 尺寸(sm 用于公共牌/对手区,lg 用于我的底牌) */
.card.sm { width: 52rpx; height: 76rpx; }
.card.md { width: 64rpx; height: 92rpx; }
.card.lg { width: 96rpx; height: 136rpx; }

.card.front .rank {
  font-weight: 700;
  color: #1c1c1c;
  line-height: 1;
}
/* 黑花色:纯黑加粗,防止浅灰看不清 */
.card.front .suit {
  line-height: 1;
  font-weight: 700;
  color: #000;
}

.card.sm .rank { font-size: 28rpx; }
.card.sm .suit { font-size: 24rpx; }
.card.md .rank { font-size: 34rpx; }
.card.md .suit { font-size: 28rpx; }
.card.lg .rank { font-size: 52rpx; }
.card.lg .suit { font-size: 44rpx; margin-top: 4rpx; }

.card.red .rank,
.card.red .suit { color: #c0392b; }

/* 牌背:PokerNow 风扁平金棕斜纹 */
.card.back {
  background:
    repeating-linear-gradient(
      45deg,
      #b8873c 0,
      #b8873c 6rpx,
      #d4a75a 6rpx,
      #d4a75a 12rpx
    );
  border-color: #8a6327;
  box-shadow: inset 0 0 0 4rpx rgba(255, 240, 200, 0.18), 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
}

/* 空位:虚线透明框(公共牌未发处) */
.card.empty {
  background: rgba(0, 0, 0, 0.15);
  border: 2rpx dashed rgba(255, 255, 255, 0.18);
  box-shadow: none;
}
