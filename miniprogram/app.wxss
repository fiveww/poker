page {
  background: #0d1b12;
  color: #eef2ee;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
}

.btn {
  border-radius: 999rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  border: none;
  font-weight: 500;
}
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(180deg, #f2cd6b 0%, #e0b23e 100%);
  color: #1a1206;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(224, 178, 62, 0.25);
}
.btn-primary.button-hover {
  background: linear-gradient(180deg, #e5be55 0%, #d1a432 100%);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(224, 178, 62, 0.5);
  color: #e0b23e;
}
.btn-ghost.button-hover {
  background: rgba(224, 178, 62, 0.12);
}

.btn.disabled,
.btn-primary.disabled {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.35);
  box-shadow: none;
}

.muted {
  color: #7d8f82;
  font-size: 24rpx;
}

input.input {
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  color: #eef2ee;
}
