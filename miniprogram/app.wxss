page {
  background: #0e2a18;
  color: #f5f5f5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
}

.btn {
  border-radius: 12rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
}

.btn-primary {
  background: #e6c34d;
  color: #2a2a2a;
  font-weight: 600;
}

.btn-ghost {
  border: 2rpx solid #e6c34d;
  color: #e6c34d;
}

.muted {
  color: #9bb0a3;
  font-size: 24rpx;
}

input.input {
  background: #16401f;
  border: 2rpx solid #2c5a36;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: #f5f5f5;
}
