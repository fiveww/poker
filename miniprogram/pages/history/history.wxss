.tip {
  text-align: center;
  margin-bottom: 32rpx;
}

.room-row {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.r-main { display: flex; flex-direction: column; gap: 6rpx; }
.r-code {
  color: #e0b23e;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.r-time { font-size: 22rpx; }
.r-join { color: #7d8f82; font-size: 26rpx; }

.empty {
  text-align: center;
  margin-top: 120rpx;
  line-height: 1.8;
}

.clear-btn { margin-top: 48rpx; }
.danger { border-color: rgba(192, 64, 64, 0.5); color: #d06b6b; }
