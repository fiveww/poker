.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #7d8f82;
  font-size: 26rpx;
}
.tab.on {
  background: #e0b23e;
  color: #1a1206;
  font-weight: 600;
}
.tab.ghost {
  margin-left: auto;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.hand-card {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.h-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.h-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.h-title {
  color: #e0b23e;
  font-weight: 600;
}
.h-sub { font-size: 22rpx; }
.h-win {
  color: #8fd19e;
  font-size: 26rpx;
  line-height: 1.5;
}
.h-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.star {
  font-size: 44rpx;
  color: #56695d;
}
.star.on {
  color: #e0b23e;
}
.small { font-size: 20rpx; }
.mini-btn { font-size: 24rpx; padding-left: 20rpx; padding-right: 20rpx; }

/* ======== 重放视图 ======== */
.replay {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.community { display: flex; gap: 10rpx; }
.rp-stage {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
}
.rp-counter { font-size: 22rpx; }
.rp-text {
  min-height: 64rpx;
  text-align: center;
  color: #eef2ee;
  line-height: 1.5;
}
.rp-ctrl {
  display: flex;
  gap: 14rpx;
  justify-content: center;
}

.final-list {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}
.lr-line { color: #eef2ee; font-size: 26rpx; line-height: 1.6; }

.empty {
  text-align: center;
  margin-top: 120rpx;
}
.back-btn {
  margin-top: 40rpx;
}
