.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #16401f;
  color: #9bb0a3;
  font-size: 26rpx;
}
.tab.on {
  background: #e6c34d;
  color: #2a2a2a;
  font-weight: 600;
}
.tab.ghost {
  margin-left: auto;
  background: transparent;
  border: 2rpx solid #2c5a36;
}

.hand-card {
  background: #16401f;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.h-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.h-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.h-title {
  color: #e6c34d;
  font-weight: 600;
}
.h-sub { font-size: 22rpx; }
.h-win {
  color: #8fd19e;
  font-size: 26rpx;
  line-height: 1.5;
}
.h-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.star {
  font-size: 44rpx;
  color: #56695d;
}
.star.on {
  color: #e6c34d;
}
.small { font-size: 20rpx; }

/* ======== 重放视图 ======== */
.replay {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #2c5a36;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.community { display: flex; gap: 10rpx; }
.rp-stage {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
}
.rp-counter { font-size: 22rpx; }
.rp-text {
  min-height: 64rpx;
  text-align: center;
  color: #f5f5f5;
  line-height: 1.5;
}
.rp-ctrl {
  display: flex;
  gap: 14rpx;
  justify-content: center;
}

.final-list {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #2c5a36;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
}
.back-btn {
  margin-top: 40rpx;
}
