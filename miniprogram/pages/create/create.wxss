.card {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
}
.label {
  font-size: 26rpx;
  color: #7d8f82;
  margin: 20rpx 0 12rpx;
}
.label.nomargin { margin: 0; }
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.row.between { justify-content: space-between; }
.row .short { flex: 1; }
.slash { color: #7d8f82; font-size: 32rpx; }
.loan-block { margin-top: 12rpx; }
.hint { margin: 12rpx 0; line-height: 1.5; }
