.hero {
  text-align: center;
  margin-bottom: 48rpx;
}
.hero .title {
  font-size: 56rpx;
  font-weight: 700;
  color: #e0b23e;
  letter-spacing: 8rpx;
}
.hero .subtitle {
  font-size: 24rpx;
  color: #7d8f82;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.login-status {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 48rpx;
}
.login-status .ok {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.login-status .openid {
  color: #7d8f82;
  font-size: 24rpx;
  word-break: break-all;
}
.login-status .loading {
  color: #7d8f82;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.footer {
  margin-top: 64rpx;
  text-align: center;
  line-height: 1.6;
}

.history-btn {
  border-color: rgba(255, 255, 255, 0.15);
  color: #aab8ad;
}
