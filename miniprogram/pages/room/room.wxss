/* ======== 房间页通用 ======== */
.code-bar {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.code-label { color: #7d8f82; font-size: 26rpx; }
.code { color: #e0b23e; font-size: 40rpx; font-weight: 700; flex: 1; letter-spacing: 4rpx; }
.share { flex: 0 0 auto; padding: 12rpx 24rpx; font-size: 26rpx; }

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

/* ======== 上局结果面板 ======== */
.last-result {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}
.lr-title { color: #e0b23e; font-weight: 600; }
.lr-line { color: #eef2ee; font-size: 26rpx; line-height: 1.5; }
.lr-reveal { display: flex; align-items: center; gap: 12rpx; }
.lr-nick { color: #7d8f82; font-size: 24rpx; }
.s-cards { display: flex; gap: 8rpx; align-items: center; }

.players {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 48rpx;
}
.players-title { color: #7d8f82; font-size: 26rpx; margin-bottom: 16rpx; }
.player {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}
.player:last-child { border-bottom: 0; }
.p-name {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.p-chips { color: #e0b23e; font-weight: 600; }
.tag {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #eef2ee;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.tag.me { background: #e0b23e; color: #1a1206; }
.tag.blind { background: rgba(224, 178, 62, 0.15); color: #e0b23e; border: 2rpx solid rgba(224, 178, 62, 0.4); }
.tag.fold-tag { background: rgba(255, 255, 255, 0.06); color: #7d8f82; }
.kick { color: #d06b6b; font-size: 24rpx; padding: 8rpx 16rpx; }

.bottom { margin-top: auto; display: flex; flex-direction: column; gap: 24rpx; }
.center { align-items: center; justify-content: center; gap: 32rpx; }

/* ======== 牌桌(table-head)======== */
.table-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.hand-no { color: #e0b23e; font-weight: 600; font-size: 28rpx; }

/* ======== 椭圆牌桌 ======== */
.table {
  position: relative;
  width: 100%;
  height: 780rpx;
  margin-bottom: 32rpx;
}

/* 毛毡椭圆桌面 */
.felt {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  height: 460rpx;
  background: radial-gradient(ellipse at center, #2a7a4d 0%, #1e5c3a 55%, #174a2d 100%);
  border: 6rpx solid #4a3520;
  border-radius: 50%;
  box-shadow:
    inset 0 0 60rpx rgba(0, 0, 0, 0.35),
    0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.pot-chip {
  background: linear-gradient(180deg, #f2cd6b 0%, #d1a432 100%);
  color: #1a1206;
  font-weight: 700;
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.4);
}

.community {
  display: flex;
  gap: 12rpx;
}

/* ======== 椭圆桌边的对手席位 ======== */
.seat {
  position: absolute;
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  transform: translate(-50%, -50%);
  z-index: 2;
}
.seat-cards {
  display: flex;
  gap: 4rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
}
.seat-avatar {
  background: rgba(13, 27, 18, 0.85);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  padding: 6rpx 14rpx;
  min-width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.seat.turn .seat-avatar {
  border-color: #e0b23e;
  box-shadow: 0 0 16rpx rgba(224, 178, 62, 0.45);
}
.seat.folded { opacity: 0.45; }
.s-name {
  font-size: 22rpx;
  color: #eef2ee;
  max-width: 140rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-weight: 500;
}
.s-chips { color: #e0b23e; font-size: 22rpx; font-weight: 600; }
.s-debt { color: #d09a9a; font-size: 18rpx; }
.seat-tags {
  display: flex;
  gap: 6rpx;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}
.seat-tags .tag { font-size: 18rpx; padding: 0 8rpx; }
.chip-btn {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #f7f3e8;
  color: #1a1a1a;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}
.s-bet {
  position: absolute;
  top: 100%;
  margin-top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #1a1206;
  font-size: 20rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #f2cd6b 0%, #d1a432 100%);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  white-space: nowrap;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

/* 椭圆定位:参数方程
   cx = 50% + a·cos(θ),cy = 44% + b·sin(θ)
   取 a=42%(x 半轴),b=38%(y 半轴),θ 从 -150°(左下)顺时针扫到 -30°(右下),
   留底部缺口给我方。1–9 个对手按下表分布: */

/* 1 个对手:正上方 */
.pos-n1.pos-0 { left: 50%; top: 6%; }

/* 2 个:左上、右上 */
.pos-n2.pos-0 { left: 22%; top: 18%; }
.pos-n2.pos-1 { left: 78%; top: 18%; }

/* 3 个:左、上、右 */
.pos-n3.pos-0 { left: 8%;  top: 40%; }
.pos-n3.pos-1 { left: 50%; top: 6%;  }
.pos-n3.pos-2 { left: 92%; top: 40%; }

/* 4 个:左、左上、右上、右 */
.pos-n4.pos-0 { left: 8%;  top: 44%; }
.pos-n4.pos-1 { left: 25%; top: 12%; }
.pos-n4.pos-2 { left: 75%; top: 12%; }
.pos-n4.pos-3 { left: 92%; top: 44%; }

/* 5 个:左、左上、上、右上、右 */
.pos-n5.pos-0 { left: 8%;  top: 50%; }
.pos-n5.pos-1 { left: 18%; top: 18%; }
.pos-n5.pos-2 { left: 50%; top: 5%;  }
.pos-n5.pos-3 { left: 82%; top: 18%; }
.pos-n5.pos-4 { left: 92%; top: 50%; }

/* 6 个:左下、左、左上、右上、右、右下(留底中给我) */
.pos-n6.pos-0 { left: 16%; top: 70%; }
.pos-n6.pos-1 { left: 6%;  top: 38%; }
.pos-n6.pos-2 { left: 20%; top: 10%; }
.pos-n6.pos-3 { left: 80%; top: 10%; }
.pos-n6.pos-4 { left: 94%; top: 38%; }
.pos-n6.pos-5 { left: 84%; top: 70%; }

/* 7 个 */
.pos-n7.pos-0 { left: 14%; top: 72%; }
.pos-n7.pos-1 { left: 6%;  top: 44%; }
.pos-n7.pos-2 { left: 14%; top: 14%; }
.pos-n7.pos-3 { left: 50%; top: 4%;  }
.pos-n7.pos-4 { left: 86%; top: 14%; }
.pos-n7.pos-5 { left: 94%; top: 44%; }
.pos-n7.pos-6 { left: 86%; top: 72%; }

/* 8 个 */
.pos-n8.pos-0 { left: 16%; top: 74%; }
.pos-n8.pos-1 { left: 5%;  top: 50%; }
.pos-n8.pos-2 { left: 8%;  top: 20%; }
.pos-n8.pos-3 { left: 32%; top: 5%;  }
.pos-n8.pos-4 { left: 68%; top: 5%;  }
.pos-n8.pos-5 { left: 92%; top: 20%; }
.pos-n8.pos-6 { left: 95%; top: 50%; }
.pos-n8.pos-7 { left: 84%; top: 74%; }

/* 9 个(满员) */
.pos-n9.pos-0 { left: 18%; top: 76%; }
.pos-n9.pos-1 { left: 5%;  top: 56%; }
.pos-n9.pos-2 { left: 5%;  top: 30%; }
.pos-n9.pos-3 { left: 18%; top: 8%;  }
.pos-n9.pos-4 { left: 50%; top: 3%;  }
.pos-n9.pos-5 { left: 82%; top: 8%;  }
.pos-n9.pos-6 { left: 95%; top: 30%; }
.pos-n9.pos-7 { left: 95%; top: 56%; }
.pos-n9.pos-8 { left: 82%; top: 76%; }

/* ======== 我方底牌面板(桌子正下方,压桌沿)======== */
.me-panel {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 92%;
  background: rgba(13, 27, 18, 0.92);
  border: 2rpx solid rgba(224, 178, 62, 0.25);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  z-index: 3;
}
.me-cards { display: flex; gap: 14rpx; }
.me-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.me-name { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; flex-wrap: wrap; justify-content: flex-end; }
.me-chips { color: #e0b23e; font-size: 36rpx; font-weight: 700; }
.me-bet {
  color: #1a1206;
  font-size: 22rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #f2cd6b 0%, #d1a432 100%);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.danger { border-color: rgba(192, 64, 64, 0.5); color: #d06b6b; }
.center-text { text-align: center; line-height: 1.6; }

/* ======== 行动条 ======== */
.action-bar {
  display: flex;
  gap: 16rpx;
}
.btn.act {
  flex: 1;
  margin: 0;
  font-size: 30rpx;
  padding-left: 0;
  padding-right: 0;
  font-weight: 600;
  border-radius: 999rpx;
}
.act.fold {
  background: rgba(192, 64, 64, 0.18);
  color: #e88;
  border: 2rpx solid rgba(192, 64, 64, 0.45);
}
.act.check,
.act.call {
  background: rgba(46, 139, 87, 0.22);
  color: #8fd19e;
  border: 2rpx solid rgba(46, 139, 87, 0.5);
}
.act.raise {
  background: rgba(224, 178, 62, 0.18);
  color: #e0b23e;
  border: 2rpx solid rgba(224, 178, 62, 0.5);
}
.act.allin {
  background: linear-gradient(180deg, #f2cd6b 0%, #d1a432 100%);
  color: #1a1206;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(224, 178, 62, 0.3);
}

.raise-panel {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.presets {
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}
.preset {
  flex: 1;
  margin: 0;
  padding-left: 0;
  padding-right: 0;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #aab8ad;
  font-size: 22rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  overflow: hidden;
}
.preset.allin {
  border-color: rgba(224, 178, 62, 0.5);
  color: #e0b23e;
}
.raise-actions {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}
.act-hint {
  font-size: 24rpx;
  margin-top: -8rpx;
}

/* ======== 借款 / 还款 ======== */
.loan-card {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.loan-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
  color: #7d8f82;
  font-size: 26rpx;
}
.loan-row .gold { color: #e0b23e; font-weight: 600; }
.loan-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
  min-height: 56rpx;
}
.debt-line { font-size: 24rpx; line-height: 1.4; }

.vote-dock { margin-top: 24rpx; }
.gold { color: #e0b23e; }
.red { color: #d06b6b; }
.neg { color: #d06b6b; }
.small-debt { font-size: 22rpx; font-weight: 400; }
.mini-btn { font-size: 24rpx; padding-left: 20rpx; padding-right: 20rpx; }
.danger-text { color: #d06b6b; }

/* ======== P7 在线状态 ======== */
.tag.off {
  background: rgba(192, 64, 64, 0.18);
  color: #d09a9a;
}

/* ======== P8 投票条 ======== */
.tool-row {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}
.vote-bar {
  background: rgba(224, 178, 62, 0.08);
  border: 2rpx solid rgba(224, 178, 62, 0.35);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.vote-bar .v-title {
  color: #e0b23e;
  font-weight: 600;
}
.v-sub { font-size: 24rpx; }
.v-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.v-actions .btn {
  flex: 1;
  margin: 0;
  padding-left: 0;
  padding-right: 0;
}
